# /etc/wisen/wisen.env: owned by root, mode 0600. systemd reads it before
# dropping to the wisen user, so the service sees these values but the file
# stays unreadable to it.
#
# Stage A holds no model API key: the server makes no model calls. Stage B
# (bottom of this file) adds one.
# (Login sessions and device tokens are random and stored hashed in the
# database, so there is no session secret to set.)

# The public address. https here makes the login cookie Secure, and it is the
# Web Push (VAPID) contact unless WISEN_VAPID_SUBJECT is set.
WISEN_CLOUD_PUBLIC_URL=https://wisen.vela-server.duckdns.org

# Web Push keys: run `wisen cloud vapid-keys` once and paste both lines.
# Leave them out to run without push. Changing them breaks every existing
# browser subscription (each browser has to enable notifications again).
WISEN_VAPID_PRIVATE_KEY=
WISEN_VAPID_PUBLIC_KEY=
# WISEN_VAPID_SUBJECT=mailto:you@example.org

# Telegram bot token from @BotFather (see deploy/README.md, "Telegram").
# Leave it empty to run without the bot. The server long-polls Telegram, so
# the bot needs no extra endpoint. Never paste it anywhere else.
WISEN_TELEGRAM_BOT_TOKEN=

# Stage B: the Synthesizer and Gardener run here over the packets the laptops
# send (deploy/README.md, "Stage B"). Upgrade the server before the laptops.
# Synthesis runs on `claude -p` (log the CLI in for the service's user); the
# Gardener uses WISEN_MODEL and its key; chat runs on DeepSeek, so the
# reflection text it answers from (already redacted) reaches DeepSeek's servers.
# WISEN_CLOUD_STAGE=b
# WISEN_MODEL=anthropic:claude-sonnet-5
# ANTHROPIC_API_KEY=
# WISEN_CHAT_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# The default in stage B; "api" falls back to WISEN_MODEL for synthesis too.
# WISEN_SYNTH_MODEL=claude-cli:sonnet
