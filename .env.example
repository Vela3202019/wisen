# wisen environment — copy to .env in the repo root (or export in your shell).
# Env vars always override ~/.wisen/config.toml; see config.example.toml for
# the same keys in file form.

# Chat model (pydantic-ai model string). Default: openai:gpt-5.6-terra —
# set the matching provider API key:
OPENAI_API_KEY=...
# WISEN_MODEL=deepseek:deepseek-v4-flash   + DEEPSEEK_API_KEY=...
# WISEN_MODEL=google:gemini-2.5-flash      + GEMINI_API_KEY=...
# WISEN_MODEL=anthropic:claude-sonnet-5    + ANTHROPIC_API_KEY=...

# Synthesis model. Default: same as the chat model above. To run the nightly
# synthesis on a Claude Pro/Max subscription instead (no API billing; needs
# the `claude` CLI installed and logged in):
# WISEN_SYNTH_MODEL=claude-cli:claude-sonnet-5

# Local MongoDB (reflections only — raw transcripts are never stored). e.g.:
#   brew services start mongodb-community    # macOS
#   docker run -d -p 27017:27017 mongo       # anywhere with Docker
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wisen

# Optional path overrides (defaults shown)
# WISEN_ROOT_DIR=~                 # dir containing the agents' dot-dirs (.claude, .codex, …)
# GIT_SCAN_DIRS=~/Developer        # comma-separated dirs scanned for repos + harness files
# WISEN_EXPORT_DIR=~/.wisen/exports/reflections
