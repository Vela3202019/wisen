# Local-first default. Start MongoDB however you like, e.g.:
#   brew services start mongodb-community
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wisen

GEMINI_API_KEY=...

# Model for chat + synthesis agents (pydantic-ai model string).
# Default: google:gemini-2.5-flash (uses GEMINI_API_KEY)
# Other providers:
#   WISEN_MODEL=deepseek:deepseek-chat      + DEEPSEEK_API_KEY=...
#   WISEN_MODEL=anthropic:claude-opus-4-8   + ANTHROPIC_API_KEY=...
# WISEN_MODEL=google:gemini-2.5-flash
# DEEPSEEK_API_KEY=...
# ANTHROPIC_API_KEY=...

# Optional overrides
# NOTES_FOLDER=~/notes
# EXPORT_FOLDER=~/.wisen/exports
